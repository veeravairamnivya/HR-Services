# Copy to .env and adjust. All settings use the HR_ prefix.
HR_DATABASE_URL=sqlite:///./hr_services.db
# HR_DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr_services
HR_SECRET_KEY=replace-with-a-long-random-string
HR_ACCESS_TOKEN_EXPIRE_MINUTES=720
HR_CORS_ORIGINS=["http://localhost:3000"]
HR_TIMEZONE=Asia/Kolkata
HR_OFFICE_START_TIME=09:45
# Load demo clients, positions and candidates on first start (set false for production)
HR_SEED_DEMO_DATA=true
